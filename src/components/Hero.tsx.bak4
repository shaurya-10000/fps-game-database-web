"use client";

import Link from "next/link";
import { useEffect, useState, useSyncExternalStore } from "react";
import { motion, useReducedMotion } from "framer-motion";
import { ArrowRight, LayoutDashboard, LogIn } from "lucide-react";
import { getToken, isTokenValid } from "@/lib/auth";

type Stats = {
  weapons: number;
  characters: number;
  maps: number;
  modes: number;
  throwables: number;
  equipment: number;
};

const emptySubscribe = () => () => {};
const getClientSnapshot = () => true;
const getServerSnapshot = () => false;

export default function Hero({ stats }: { stats: Stats }) {
  const [isLoggedIn, setIsLoggedIn] = useState(false);
  const mounted = useSyncExternalStore(emptySubscribe, getClientSnapshot, getServerSnapshot);
  const reduce = useReducedMotion();

  useEffect(() => {
    const check = () => setIsLoggedIn(isTokenValid(getToken()));
    check();
    window.addEventListener("fps-auth-changed", check);
    return () => window.removeEventListener("fps-auth-changed", check);
  }, []);

  const rise = (delay: number) => ({
    initial: { opacity: 0, y: reduce ? 0 : 12 },
    animate: { opacity: 1, y: 0 },
    transition: { duration: reduce ? 0 : 0.5, delay, ease: [0.22, 1, 0.36, 1] as const },
  });

  const totalEntries =
    stats.weapons + stats.characters + stats.maps + stats.modes + stats.throwables + stats.equipment;

  return (
    <section className="relative overflow-hidden border-b border-border bg-background">
      <div
        aria-hidden="true"
        className="pointer-events-none absolute inset-0 opacity-[0.025]"
        style={{
          backgroundImage:
            "linear-gradient(to right, currentColor 1px, transparent 1px), linear-gradient(to bottom, currentColor 1px, transparent 1px)",
          backgroundSize: "96px 96px",
          maskImage: "linear-gradient(to bottom right, black, transparent 65%)",
          WebkitMaskImage: "linear-gradient(to bottom right, black, transparent 65%)",
        }}
      />

      <div className="relative mx-auto grid max-w-[1600px] gap-16 px-5 py-24 sm:px-8 sm:py-32 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:items-end lg:gap-24 lg:px-10 lg:py-36 xl:px-16">
        {/* ── left: editorial column ─────────────────────────────────── */}
        <div className="min-w-0">
          <motion.div {...rise(0)} className="flex items-center gap-3">
            <span className="text-[11px] font-medium tabular-nums text-muted">01</span>
            <span className="h-px flex-1 bg-border" />
            <span className="text-[10.5px] font-semibold uppercase tracking-[0.22em] text-muted">
              The reference
            </span>
          </motion.div>

          <motion.h1
            {...rise(0.08)}
            className="mt-10 font-heading text-[clamp(2.5rem,7.5vw,6rem)] font-bold uppercase leading-[0.88] tracking-[-0.02em] text-foreground"
          >
            Know the
            <br />
            meta
            <span className="text-muted/60">.</span>
          </motion.h1>

          <motion.p
            {...rise(0.16)}
            className="mt-8 max-w-[44ch] text-[15px] leading-[1.7] text-muted"
          >
            Ballistics, maps, modes and operators — fully documented. Live Elo,
            tier progression and realtime squad chat. Everything a competitive
            player needs, without the noise.
          </motion.p>

          <motion.div {...rise(0.22)} className="mt-10 flex items-center gap-3">
            {!mounted ? (
              <div className="h-11 w-40 animate-pulse rounded-md bg-foreground/[0.06]" />
            ) : isLoggedIn ? (
              <>
                <Link
                  href="/dashboard"
                  className="group inline-flex h-11 items-center gap-2.5 rounded-md bg-foreground px-5 text-[13px] font-semibold text-background transition-opacity hover:opacity-90"
                >
                  <LayoutDashboard className="size-4" />
                  Open dashboard
                  <ArrowRight className="size-3.5 -translate-x-0.5 opacity-0 transition-all group-hover:translate-x-0 group-hover:opacity-60" />
                </Link>
                <Link
                  href="/weapons"
                  className="inline-flex h-11 items-center text-[13px] font-medium text-muted transition-colors hover:text-foreground"
                >
                  or browse the catalog
                </Link>
              </>
            ) : (
              <>
                <Link
                  href="/dashboard/login"
                  className="group inline-flex h-11 items-center gap-2.5 rounded-md bg-foreground px-5 text-[13px] font-semibold text-background transition-opacity hover:opacity-90"
                >
                  <LogIn className="size-4" />
                  Sign in
                  <ArrowRight className="size-3.5 -translate-x-0.5 opacity-0 transition-all group-hover:translate-x-0 group-hover:opacity-60" />
                </Link>
                <Link
                  href="/dashboard/login"
                  className="inline-flex h-11 items-center text-[13px] font-medium text-muted transition-colors hover:text-foreground"
                >
                  or create an account
                </Link>
              </>
            )}
          </motion.div>
        </div>

        {/* ── right: data panel ──────────────────────────────────────── */}
        <motion.aside
          {...rise(0.3)}
          className="border-t border-border pt-8 lg:border-l lg:border-t-0 lg:pl-10 lg:pt-0"
        >
          <div className="flex items-baseline justify-between">
            <span className="text-[10.5px] font-semibold uppercase tracking-[0.18em] text-muted">
              Currently indexed
            </span>
            <span className="font-mono text-[11px] tabular-nums text-muted">
              v1
            </span>
          </div>

          <p className="mt-4 font-heading text-[clamp(3.5rem,9vw,6.5rem)] font-bold leading-[0.85] tracking-[-0.03em] tabular-nums text-foreground">
            {totalEntries}
          </p>
          <p className="mt-2 text-[12px] text-muted">entries across six collections</p>

          <dl className="mt-8 grid grid-cols-3 gap-x-6 gap-y-5 border-t border-border pt-6">
            <div>
              <dt className="text-[10px] font-medium uppercase tracking-[0.14em] text-muted">Weapons</dt>
              <dd className="mt-1 font-mono text-[15px] font-semibold tabular-nums text-foreground">
                {stats.weapons}
              </dd>
            </div>
            <div>
              <dt className="text-[10px] font-medium uppercase tracking-[0.14em] text-muted">Operators</dt>
              <dd className="mt-1 font-mono text-[15px] font-semibold tabular-nums text-foreground">
                {stats.characters}
              </dd>
            </div>
            <div>
              <dt className="text-[10px] font-medium uppercase tracking-[0.14em] text-muted">Maps</dt>
              <dd className="mt-1 font-mono text-[15px] font-semibold tabular-nums text-foreground">
                {stats.maps}
              </dd>
            </div>
            <div>
              <dt className="text-[10px] font-medium uppercase tracking-[0.14em] text-muted">Modes</dt>
              <dd className="mt-1 font-mono text-[15px] font-semibold tabular-nums text-foreground">
                {stats.modes}
              </dd>
            </div>
            <div>
              <dt className="text-[10px] font-medium uppercase tracking-[0.14em] text-muted">Throwables</dt>
              <dd className="mt-1 font-mono text-[15px] font-semibold tabular-nums text-foreground">
                {stats.throwables}
              </dd>
            </div>
            <div>
              <dt className="text-[10px] font-medium uppercase tracking-[0.14em] text-muted">Equipment</dt>
              <dd className="mt-1 font-mono text-[15px] font-semibold tabular-nums text-foreground">
                {stats.equipment}
              </dd>
            </div>
          </dl>
        </motion.aside>
      </div>
    </section>
  );
}
