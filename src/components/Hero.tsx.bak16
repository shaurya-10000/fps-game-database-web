"use client";

import Link from "next/link";
import { useEffect, useState, useSyncExternalStore } from "react";
import { motion } from "framer-motion";
import { ArrowRight, LayoutDashboard, Shield, Crosshair, TrendingUp } from "lucide-react";
import { getToken, isTokenValid } from "@/lib/auth";

type Stats = {
  weapons: number;
  characters: number;
  maps: number;
  modes: number;
  throwables: number;
  equipment: number;
};

const emptySubscribe = () => () => {};
const getClientSnapshot = () => true;
const getServerSnapshot = () => false;

export default function Hero({ stats }: { stats: Stats }) {
  const [isLoggedIn, setIsLoggedIn] = useState(false);
  const mounted = useSyncExternalStore(emptySubscribe, getClientSnapshot, getServerSnapshot);

  useEffect(() => {
    const check = () => setIsLoggedIn(isTokenValid(getToken()));
    check();
    window.addEventListener("fps-auth-changed", check);
    return () => window.removeEventListener("fps-auth-changed", check);
  }, []);

  return (
    <section className="relative isolate min-h-[90vh] overflow-hidden bg-[#050505] flex items-center">
      {/* Studio Lighting / Ambient Depth */}
      <div aria-hidden="true" className="absolute inset-0 overflow-hidden pointer-events-none">
        <div className="absolute -top-[20%] left-[10%] h-[800px] w-[800px] rounded-full bg-amber-500/5 blur-[150px]" />
        <div className="absolute bottom-[-10%] right-[10%] h-[600px] w-[600px] rounded-full bg-blue-500/5 blur-[120px]" />
        {/* Subtle grid pattern that fades out */}
        <div 
          className="absolute inset-0 opacity-[0.03]" 
          style={{
            backgroundImage: "linear-gradient(to right, #fff 1px, transparent 1px), linear-gradient(to bottom, #fff 1px, transparent 1px)",
            backgroundSize: "96px 96px",
            maskImage: "linear-gradient(to bottom, black 20%, transparent 80%)",
            WebkitMaskImage: "linear-gradient(to bottom, black 20%, transparent 80%)"
          }} 
        />
      </div>

      <div className="relative mx-auto w-full max-w-[1400px] px-5 py-24 sm:px-8 lg:px-12 xl:px-16 grid lg:grid-cols-[1.2fr_1fr] gap-16 lg:gap-8 items-center">
        
        {/* Left Column: Editorial Typography */}
        <div className="flex flex-col z-10 relative">
          <div className="flex items-center gap-3 mb-8">
            <span className="flex h-2 w-2 rounded-full bg-amber-500 animate-pulse shadow-[0_0_10px_rgba(245,158,11,0.5)]" />
            <span className="font-mono text-[11px] font-bold uppercase tracking-[0.2em] text-zinc-400">
              The competitive FPS index
            </span>
          </div>

          <h1 className="font-heading text-[clamp(3.5rem,7vw,7.5rem)] font-bold uppercase leading-[0.85] tracking-[-0.02em] text-white">
            Master the
            <span className="block text-zinc-500">meta.</span>
          </h1>

          <p className="mt-8 max-w-md text-[16px] leading-relaxed text-zinc-400">
            Ballistics, maps, modes and operators — meticulously documented. Live Elo, tier progression and realtime squad chat. Built for those who play to win.
          </p>

          <div className="mt-12 flex flex-wrap items-center gap-5">
            {!mounted ? (
              <div className="h-12 w-48 animate-pulse rounded-full bg-white/5" />
            ) : isLoggedIn ? (
              <Link
                href="/dashboard"
                className="group inline-flex h-12 items-center gap-2.5 rounded-full bg-white px-7 text-[14px] font-bold text-black transition-transform hover:scale-[1.02]"
              >
                <LayoutDashboard className="size-4" />
                Open dashboard
                <ArrowRight className="size-4 -translate-x-1 opacity-0 transition-all group-hover:translate-x-0 group-hover:opacity-100" />
              </Link>
            ) : (
              <Link
                href="/dashboard/login"
                className="group inline-flex h-12 items-center gap-2.5 rounded-full bg-white px-7 text-[14px] font-bold text-black transition-transform hover:scale-[1.02]"
              >
                Create free account
                <ArrowRight className="size-4 -translate-x-1 opacity-0 transition-all group-hover:translate-x-0 group-hover:opacity-100" />
              </Link>
            )}
            
            <Link
              href="/weapons"
              className="group flex items-center gap-2 text-[14px] font-medium text-zinc-400 transition-colors hover:text-white"
            >
              Browse database
              <ArrowRight className="size-4 transition-transform group-hover:translate-x-1" />
            </Link>
          </div>
        </div>

        {/* Right Column: High-Effort UI Overlay */}
        <div className="relative z-10 lg:ml-auto w-full max-w-[420px] perspective-[1000px]">
          {/* Main Player Card */}
          <motion.div 
            initial={{ opacity: 0, y: 40, rotateX: 10, rotateY: -10 }}
            animate={{ opacity: 1, y: 0, rotateX: 0, rotateY: 0 }}
            transition={{ duration: 1, ease: [0.16, 1, 0.3, 1] }}
            className="relative overflow-hidden rounded-3xl border border-white/10 bg-[#0a0a0a]/80 p-6 shadow-2xl backdrop-blur-xl"
          >
            {/* Glow behind the card */}
            <div className="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-amber-500/50 to-transparent" />
            
            <div className="flex items-center justify-between mb-8">
              <div className="flex items-center gap-4">
                <div className="flex size-14 items-center justify-center rounded-2xl bg-gradient-to-br from-amber-500 to-orange-600 text-xl font-bold text-white shadow-lg shadow-amber-500/20">
                  V
                </div>
                <div>
                  <h3 className="text-[16px] font-bold text-white">Viper</h3>
                  <p className="flex items-center gap-1.5 text-[12px] font-medium text-amber-500">
                    <Shield size={12} /> Master Tier
                  </p>
                </div>
              </div>
              <div className="text-right">
                <div className="font-mono text-[24px] font-bold text-white leading-none">3140</div>
                <div className="text-[10px] uppercase tracking-wider text-zinc-500 mt-1">Rating</div>
              </div>
            </div>

            <div className="space-y-4">
              <div className="space-y-2">
                <div className="flex justify-between text-[12px] font-medium text-zinc-400">
                  <span>Win Rate</span>
                  <span className="text-white">64.2%</span>
                </div>
                <div className="h-2 w-full rounded-full bg-white/5 overflow-hidden">
                  <div className="h-full rounded-full bg-emerald-500 w-[64.2%]" />
                </div>
              </div>
              <div className="space-y-2">
                <div className="flex justify-between text-[12px] font-medium text-zinc-400">
                  <span>Headshot %</span>
                  <span className="text-white">42.8%</span>
                </div>
                <div className="h-2 w-full rounded-full bg-white/5 overflow-hidden">
                  <div className="h-full rounded-full bg-amber-500 w-[42.8%]" />
                </div>
              </div>
            </div>

            <div className="mt-8 grid grid-cols-3 gap-3 border-t border-white/10 pt-6">
              <div className="text-center">
                <div className="text-[12px] font-bold text-white">1.4</div>
                <div className="text-[10px] uppercase text-zinc-500">K/D</div>
              </div>
              <div className="text-center border-x border-white/10">
                <div className="text-[12px] font-bold text-white">28</div>
                <div className="text-[10px] uppercase text-zinc-500">Matches</div>
              </div>
              <div className="text-center">
                <div className="text-[12px] font-bold text-white">9</div>
                <div className="text-[10px] uppercase text-zinc-500">Win Streak</div>
              </div>
            </div>
          </motion.div>

          {/* Floating Stat Chips overlapping the card (Human touch) */}
          <motion.div 
            initial={{ opacity: 0, x: -20 }}
            animate={{ opacity: 1, x: 0 }}
            transition={{ duration: 0.8, delay: 0.4 }}
            className="absolute -left-12 top-1/2 -translate-y-1/2 hidden sm:flex items-center gap-3 rounded-2xl border border-white/10 bg-[#0a0a0a]/90 p-3 pr-5 shadow-xl backdrop-blur-md"
          >
            <div className="flex size-10 items-center justify-center rounded-xl bg-blue-500/20 text-blue-400">
              <Crosshair size={18} />
            </div>
            <div>
              <div className="text-[11px] text-zinc-400 font-medium">Weapons Indexed</div>
              <div className="text-[16px] font-bold text-white leading-none mt-0.5">{stats.weapons}</div>
            </div>
          </motion.div>

          <motion.div 
            initial={{ opacity: 0, x: 20 }}
            animate={{ opacity: 1, x: 0 }}
            transition={{ duration: 0.8, delay: 0.5 }}
            className="absolute -right-8 bottom-12 hidden sm:flex items-center gap-3 rounded-2xl border border-white/10 bg-[#0a0a0a]/90 p-3 pr-5 shadow-xl backdrop-blur-md"
          >
            <div className="flex size-10 items-center justify-center rounded-xl bg-emerald-500/20 text-emerald-400">
              <TrendingUp size={18} />
            </div>
            <div>
              <div className="text-[11px] text-zinc-400 font-medium">Maps Mapped</div>
              <div className="text-[16px] font-bold text-white leading-none mt-0.5">{stats.maps}</div>
            </div>
          </motion.div>

        </div>
      </div>
    </section>
  );
}
