"use client";

import Link from "next/link";
import { useEffect, useState, useSyncExternalStore } from "react";
import { motion } from "framer-motion";
import { ArrowUpRight, Crosshair, Map, Swords, Trophy } from "lucide-react";
import { getToken, isTokenValid } from "@/lib/auth";

type Stats = {
  weapons: number;
  characters: number;
  maps: number;
  modes: number;
  throwables: number;
  equipment: number;
};

const emptySubscribe = () => () => {};
const getClientSnapshot = () => true;
const getServerSnapshot = () => false;

export default function Hero({ stats }: { stats: Stats }) {
  const [isLoggedIn, setIsLoggedIn] = useState(false);
  const mounted = useSyncExternalStore(emptySubscribe, getClientSnapshot, getServerSnapshot);

  useEffect(() => {
    const check = () => setIsLoggedIn(isTokenValid(getToken()));
    check();
    window.addEventListener("fps-auth-changed", check);
    return () => window.removeEventListener("fps-auth-changed", check);
  }, []);

  return (
    <section className="relative border-b border-border bg-background">
      <div className="mx-auto grid max-w-[1600px] lg:grid-cols-[1.2fr_1fr] lg:divide-x lg:divide-border">
        
        {/* Left: Editorial text block (Asymmetric, tight line height) */}
        <div className="flex flex-col justify-between px-5 py-16 sm:px-8 sm:py-24 lg:px-12 xl:px-16 lg:py-32">
          <div>
            <div className="flex items-center gap-3 mb-8">
              <span className="h-px w-8 bg-amber-500" />
              <span className="text-[11px] font-mono uppercase tracking-widest text-muted">
                v1.0 / Season 1
              </span>
            </div>
            
            <h1 className="font-heading text-[clamp(3rem,5vw,4.5rem)] font-bold uppercase leading-[0.85] tracking-tight text-foreground">
              Know the <br />
              meta <span className="text-muted">before</span> <br />
              the lobby.
            </h1>
            
            <p className="mt-8 max-w-sm text-[15px] leading-relaxed text-muted">
              Ballistics, maps, modes and operators — documented. Live Elo, tier progression and realtime squad chat. Everything a competitive player needs.
            </p>
          </div>

          <div className="mt-12 flex items-center gap-4">
            {!mounted ? (
              <div className="h-11 w-40 animate-pulse rounded-none bg-foreground/10" />
            ) : isLoggedIn ? (
              <Link
                href="/dashboard"
                className="group inline-flex h-11 items-center gap-3 rounded-none bg-foreground px-6 text-[13px] font-semibold text-background transition-colors hover:bg-foreground/90"
              >
                Open dashboard
                <ArrowUpRight className="size-4 opacity-50 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
              </Link>
            ) : (
              <Link
                href="/dashboard/login"
                className="group inline-flex h-11 items-center gap-3 rounded-none bg-foreground px-6 text-[13px] font-semibold text-background transition-colors hover:bg-foreground/90"
              >
                Create account
                <ArrowUpRight className="size-4 opacity-50 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
              </Link>
            )}
            <Link
              href="/weapons"
              className="inline-flex h-11 items-center px-2 text-[13px] font-medium text-muted transition-colors hover:text-foreground"
            >
              Explore catalog
            </Link>
          </div>
        </div>

        {/* Right: Functional Telemetry Block (Dense, data-driven) */}
        <div className="bg-surface/30 relative flex flex-col justify-center px-5 py-16 sm:px-8 lg:px-12 xl:px-16">
          
          {/* Subtle top border accent */}
          <div className="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-border to-transparent" />

          <div className="grid gap-6">
            
            {/* Leaderboard Panel */}
            <div className="border border-border bg-background">
              <div className="flex items-center justify-between border-b border-border px-4 py-2 bg-surface/50">
                <span className="flex items-center gap-2 text-[11px] font-mono uppercase tracking-widest text-muted">
                  <Trophy size={12} className="text-amber-500" />
                  Top Elo
                </span>
                <span className="text-[10px] font-mono text-muted">Global</span>
              </div>
              <div className="divide-y divide-border/50 font-mono text-[13px]">
                <div className="flex items-center justify-between px-4 py-2.5 bg-surface/20">
                  <div className="flex items-center gap-3">
                    <span className="text-amber-500 font-bold w-3">1</span>
                    <span className="text-foreground">Viper</span>
                  </div>
                  <span className="text-foreground font-semibold">3140</span>
                </div>
                <div className="flex items-center justify-between px-4 py-2.5">
                  <div className="flex items-center gap-3">
                    <span className="text-muted w-3">2</span>
                    <span className="text-foreground/80">Talon</span>
                  </div>
                  <span className="text-muted">2895</span>
                </div>
                <div className="flex items-center justify-between px-4 py-2.5">
                  <div className="flex items-center gap-3">
                    <span className="text-muted w-3">3</span>
                    <span className="text-foreground/80">Kestrel</span>
                  </div>
                  <span className="text-muted">2410</span>
                </div>
              </div>
            </div>

            {/* Telemetry Grid */}
            <div className="grid grid-cols-2 gap-px bg-border border border-border">
              <div className="bg-background p-4 flex flex-col gap-1">
                <span className="flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider text-muted">
                  <Crosshair size={12} /> Weapons
                </span>
                <span className="font-mono text-2xl font-semibold text-foreground">{stats.weapons}</span>
              </div>
              <div className="bg-background p-4 flex flex-col gap-1">
                <span className="flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider text-muted">
                  <Map size={12} /> Maps
                </span>
                <span className="font-mono text-2xl font-semibold text-foreground">{stats.maps}</span>
              </div>
              <div className="bg-background p-4 flex flex-col gap-1">
                <span className="flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider text-muted">
                  <Swords size={12} /> Modes
                </span>
                <span className="font-mono text-2xl font-semibold text-foreground">{stats.modes}</span>
              </div>
              <div className="bg-background p-4 flex flex-col gap-1">
                <span className="flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider text-muted">
                  <Trophy size={12} /> Operators
                </span>
                <span className="font-mono text-2xl font-semibold text-foreground">{stats.characters}</span>
              </div>
            </div>

          </div>
        </div>

      </div>
    </section>
  );
}
