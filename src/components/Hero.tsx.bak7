"use client";

import Link from "next/link";
import { useEffect, useState, useSyncExternalStore } from "react";
import { motion, useReducedMotion } from "framer-motion";
import { ArrowRight, LayoutDashboard } from "lucide-react";
import { getToken, isTokenValid } from "@/lib/auth";

type Stats = {
  weapons: number;
  characters: number;
  maps: number;
  modes: number;
  throwables: number;
  equipment: number;
};

const emptySubscribe = () => () => {};
const getClientSnapshot = () => true;
const getServerSnapshot = () => false;

export default function Hero({ stats }: { stats: Stats }) {
  const [isLoggedIn, setIsLoggedIn] = useState(false);
  const [videoReady, setVideoReady] = useState(false);
  const mounted = useSyncExternalStore(emptySubscribe, getClientSnapshot, getServerSnapshot);
  const reduce = useReducedMotion();

  useEffect(() => {
    const check = () => setIsLoggedIn(isTokenValid(getToken()));
    check();
    window.addEventListener("fps-auth-changed", check);
    return () => window.removeEventListener("fps-auth-changed", check);
  }, []);

  const rise = (delay: number) => ({
    initial: { opacity: 0, y: reduce ? 0 : 16 },
    animate: { opacity: 1, y: 0 },
    transition: { duration: reduce ? 0 : 0.7, delay, ease: [0.22, 1, 0.36, 1] as const },
  });

  return (
    <section className="relative isolate flex min-h-[88vh] items-center justify-center overflow-hidden bg-background">
      {/* fallback: theme-aware radial wash. No literal black, so light mode works. */}
      <div
        aria-hidden="true"
        className="absolute inset-0"
        style={{
          background:
            "radial-gradient(ellipse at center, var(--surface) 0%, var(--background) 65%, var(--background) 100%)",
        }}
      />

      {/* looping background video (opt-in when motion is allowed) */}
      {!reduce && (
        <video
          className={`absolute inset-0 h-full w-full object-cover transition-opacity duration-1000 ${
            videoReady ? "opacity-70 dark:opacity-50" : "opacity-0"
          }`}
          autoPlay
          muted
          loop
          playsInline
          preload="metadata"
          poster="/hero-poster.jpg"
          onCanPlay={() => setVideoReady(true)}
          aria-hidden="true"
        >
          <source src="/hero.mp4" type="video/mp4" />
        </video>
      )}

      {/* scrims — neutral dark over video only; text contrast comes from the theme token layer */}
      <div aria-hidden="true" className="absolute inset-0 bg-background/55 dark:bg-black/45" />
      <div
        aria-hidden="true"
        className="absolute inset-0"
        style={{
          background:
            "radial-gradient(ellipse at center, transparent 0%, var(--background) 100%)",
          opacity: 0.85,
        }}
      />
      <div aria-hidden="true" className="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-background to-transparent" />
      <div aria-hidden="true" className="absolute inset-x-0 bottom-0 h-48 bg-gradient-to-t from-background to-transparent" />

      <div className="relative z-10 mx-auto flex max-w-3xl flex-col items-center px-5 py-24 text-center sm:px-8">
        <motion.h1
          {...rise(0)}
          className="font-heading text-[clamp(2.75rem,7.5vw,6rem)] font-bold uppercase leading-[0.92] tracking-[-0.02em] text-foreground"
        >
          Know the meta
          <span className="block text-muted">before the lobby.</span>
        </motion.h1>

        <motion.p
          {...rise(0.1)}
          className="mt-7 max-w-xl text-[15.5px] leading-relaxed text-muted"
        >
          Ballistics, maps, modes and operators — documented. Live Elo, tier
          progression and realtime squad chat in one place.
        </motion.p>

        <motion.div {...rise(0.18)} className="mt-10">
          {!mounted ? (
            <div className="h-12 w-48 animate-pulse rounded-full bg-foreground/10" />
          ) : isLoggedIn ? (
            <Link
              href="/dashboard"
              className="group inline-flex h-12 items-center gap-2.5 rounded-full bg-foreground px-7 text-[13.5px] font-semibold text-background transition-transform hover:scale-[1.02]"
            >
              <LayoutDashboard className="size-4" />
              Open dashboard
              <ArrowRight className="size-4 -translate-x-1 opacity-0 transition-all group-hover:translate-x-0 group-hover:opacity-100" />
            </Link>
          ) : (
            <Link
              href="/dashboard/login"
              className="group inline-flex h-12 items-center gap-2.5 rounded-full bg-foreground px-7 text-[13.5px] font-semibold text-background transition-transform hover:scale-[1.02]"
            >
              Create free account
              <ArrowRight className="size-4 -translate-x-1 opacity-0 transition-all group-hover:translate-x-0 group-hover:opacity-100" />
            </Link>
          )}
        </motion.div>
      </div>
    </section>
  );
}
