"use client";

import Link from "next/link";
import { useEffect, useState, useSyncExternalStore } from "react";
import { motion, useReducedMotion } from "framer-motion";
import { ArrowRight, LayoutDashboard } from "lucide-react";
import { getToken, isTokenValid } from "@/lib/auth";

type Stats = {
  weapons: number;
  characters: number;
  maps: number;
  modes: number;
  throwables: number;
  equipment: number;
};

const emptySubscribe = () => () => {};
const getClientSnapshot = () => true;
const getServerSnapshot = () => false;

export default function Hero({ stats }: { stats: Stats }) {
  const [isLoggedIn, setIsLoggedIn] = useState(false);
  const mounted = useSyncExternalStore(emptySubscribe, getClientSnapshot, getServerSnapshot);
  const reduce = useReducedMotion();

  useEffect(() => {
    const check = () => setIsLoggedIn(isTokenValid(getToken()));
    check();
    window.addEventListener("fps-auth-changed", check);
    return () => window.removeEventListener("fps-auth-changed", check);
  }, []);

  const rise = (delay: number) => ({
    initial: { opacity: 0, y: reduce ? 0 : 14 },
    animate: { opacity: 1, y: 0 },
    transition: { duration: reduce ? 0 : 0.55, delay, ease: [0.22, 1, 0.36, 1] as const },
  });

  return (
    <section className="relative overflow-hidden border-b border-border bg-background">
      <div
        aria-hidden="true"
        className="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-border to-transparent"
      />
      <div
        aria-hidden="true"
        className="pointer-events-none absolute inset-0 opacity-[0.03]"
        style={{
          backgroundImage:
            "radial-gradient(circle at 1px 1px, currentColor 1px, transparent 0)",
          backgroundSize: "32px 32px",
          maskImage: "radial-gradient(ellipse 70% 60% at 50% 0%, black, transparent)",
          WebkitMaskImage: "radial-gradient(ellipse 70% 60% at 50% 0%, black, transparent)",
        }}
      />

      <div className="relative mx-auto flex max-w-3xl flex-col items-center px-5 py-28 text-center sm:px-8 sm:py-36 lg:py-40">
        <motion.div
          {...rise(0)}
          className="inline-flex items-center gap-2 rounded-full border border-border bg-surface/60 px-3 py-1 text-[11px] font-medium text-muted backdrop-blur-sm"
        >
          <span className="size-1.5 rounded-full bg-emerald-500" />
          Competitive FPS reference
        </motion.div>

        <motion.h1
          {...rise(0.06)}
          className="mt-8 font-heading text-[clamp(2.75rem,7vw,5.5rem)] font-bold uppercase leading-[0.95] tracking-[-0.02em] text-foreground"
        >
          Know the meta
          <span className="block text-muted">before the lobby.</span>
        </motion.h1>

        <motion.p
          {...rise(0.12)}
          className="mt-6 max-w-lg text-[15.5px] leading-relaxed text-muted"
        >
          Ballistics, maps, modes and operators — documented. Live Elo, tier
          progression and realtime squad chat in one place.
        </motion.p>

        <motion.div {...rise(0.18)} className="mt-10 flex items-center gap-3">
          {!mounted ? (
            <div className="h-11 w-44 animate-pulse rounded-lg bg-foreground/[0.06]" />
          ) : isLoggedIn ? (
            <Link
              href="/dashboard"
              className="group inline-flex h-11 items-center gap-2 rounded-lg bg-foreground px-6 text-[13.5px] font-semibold text-background transition-opacity hover:opacity-90"
            >
              <LayoutDashboard className="size-4" />
              Open dashboard
              <ArrowRight className="size-4 -translate-x-1 opacity-0 transition-all group-hover:translate-x-0 group-hover:opacity-100" />
            </Link>
          ) : (
            <Link
              href="/dashboard/login"
              className="group inline-flex h-11 items-center gap-2 rounded-lg bg-foreground px-6 text-[13.5px] font-semibold text-background transition-opacity hover:opacity-90"
            >
              Create free account
              <ArrowRight className="size-4 -translate-x-1 opacity-0 transition-all group-hover:translate-x-0 group-hover:opacity-100" />
            </Link>
          )}
        </motion.div>

        <motion.dl
          {...rise(0.26)}
          className="mt-16 grid w-full grid-cols-2 gap-x-8 gap-y-6 border-t border-border pt-8 sm:grid-cols-4"
        >
          {(
            [
              [stats.weapons, "Weapons"],
              [stats.characters, "Operators"],
              [stats.maps, "Maps"],
              [stats.modes, "Modes"],
            ] as const
          ).map(([count, label]) => (
            <div key={label} className="flex flex-col items-center">
              <dd className="font-mono text-[22px] font-semibold tabular-nums text-foreground">
                {count}
              </dd>
              <dt className="mt-1 text-[10.5px] font-medium uppercase tracking-[0.16em] text-muted">
                {label}
              </dt>
            </div>
          ))}
        </motion.dl>
      </div>
    </section>
  );
}
