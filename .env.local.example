# Backend base URL. Dev default is the local express server on port 3000.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Existing — same Atlas cluster as the backend
MONGODB_URI=mongodb://...
# Optional TURN relay for calls between different networks
# NEXT_PUBLIC_TURN_URL=turn:turn.example.com:3478,turns:turn.example.com:5349
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=
